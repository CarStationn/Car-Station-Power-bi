# ============================================================
# Configuração da pilha Docker — copie para .env e preencha.
#
#   cp .env.example .env
#
# O .env NÃO vai para o Git. Nenhuma credencial deste projeto
# deve trafegar por e-mail, WhatsApp ou dentro de chamado.
#
# (Para rodar o backend sem Docker, use backend/.env.example.)
# ============================================================

# ---------- Banco ----------
# Usados para CRIAR o banco no container na primeira subida e,
# depois, para a API se conectar. DB_HOST e DB_PORT são definidos
# pelo próprio compose — não precisam estar aqui.
DB_USER=carstation
DB_PASSWORD=
DB_NAME=carstation_bi

# ---------- Segurança ----------
# Assina os tokens de sessão. Quem tiver este valor forja um token
# de administrador sem saber senha nenhuma. Gere um novo — não
# reaproveite o de outro ambiente:
#
#   docker run --rm node:20-alpine node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
#
# Ao trocar, todos os usuários precisam fazer login de novo.
JWT_SECRET=

# ---------- Proxies na frente da aplicação ----------
# Quantidade EXATA de saltos até o cliente. Errar aqui faz o limite
# de tentativas de login contar todos os usuários num balde só.
#   1  Nginx sozinho na frente
#   2  Cloudflare Tunnel -> Nginx -> API   <- provável aqui
TRUST_PROXY=2

# ---------- CORS ----------
# Endereço exato de onde o portal é servido, sem barra no final.
# Precisa bater com o que o usuário digita no navegador.
CORS_ORIGIN=https://indicadores.carstation.com.br

NODE_ENV=production
