# ============================================================
# Modelo de configuração — copie para backend/.env e preencha.
# O arquivo .env NÃO vai para o Git (está no .gitignore).
# ============================================================

PORT=3001
NODE_ENV=production

# ---------- Banco PostgreSQL ----------
# Em servidor próprio, o banco costuma rodar na mesma máquina.
# Em provedor gerenciado (Supabase, Railway, Neon), use o host que ele fornece.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=carstation
DB_PASSWORD=
DB_NAME=carstation_bi

# ---------- Segurança ----------
# Assina os tokens de sessão. Quem tiver este valor consegue forjar um token
# de administrador sem saber senha nenhuma: trate como senha e nunca reaproveite
# entre ambientes. Gere um novo com:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=

# ---------- CORS ----------
# Endereço EXATO de onde o portal é servido (sem barra no final).
# Só as origens listadas aqui conseguem chamar a API pelo navegador.
# Aceita várias, separadas por vírgula.
# Se ficar vazio, o servidor libera apenas localhost — útil só em desenvolvimento.
CORS_ORIGIN=https://indicadores.seu-dominio.com.br
