# ============================================================
# Frontend do Portal Car Station — Nginx servindo arquivos
# estáticos e repassando /api para o container da API.
# O que entra na imagem é filtrado pelo .dockerignore.
# ============================================================
FROM nginx:alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY . /usr/share/nginx/html/

# Rede de segurança: se algum arquivo indevido escapar do
# .dockerignore, ele não fica publicado.
RUN rm -rf /usr/share/nginx/html/backend \
           /usr/share/nginx/html/nginx.conf \
           /usr/share/nginx/html/Dockerfile.web

# Aqui o portal e a API saem do mesmo endereço (o Nginx repassa /api),
# então o endereço da API é sempre relativo. O config.js do repositório
# continua apontando para o Render, que atende o Vercel até a virada.
RUN printf "window.API_BASE_URL = '/api';\n" > /usr/share/nginx/html/config.js
